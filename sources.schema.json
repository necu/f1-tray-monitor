{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/necu/f1-tray-monitor/sources.schema.json",
  "title": "F1 Tray Monitor · catálogo de fuentes",
  "description": "Esquema de sources.json. Las claves que empiezan por guion bajo (_ejemplo, _comentario...) se ignoran al leer el catálogo.",
  "type": "object",
  "required": ["version", "services", "rules"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}([Tt ].+)?$"
    },
    "refreshHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "short", "color"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "short": { "type": "string", "minLength": 1, "maxLength": 8 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["options"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer" },
        "starts": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([Tt ].+)?$"
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}([Tt ].+)?$"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": { "type": "boolean" },
            "id": { "type": ["string", "integer"] },
            "year": { "type": ["integer", "string"] },
            "gp": { "type": "string" },
            "session": { "type": "string" },
            "titleContains": { "type": "string" },
            "type": { "type": "string" }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/option" }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "service": { "type": "string" },
        "quality": { "type": "string" },
        "lang": { "type": "string" },
        "primary": { "type": "boolean" }
      }
    }
  }
}
